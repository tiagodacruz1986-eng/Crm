# Caddy obtient et renouvelle automatiquement le certificat https (Let's Encrypt) pour votre domaine.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy garage:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
